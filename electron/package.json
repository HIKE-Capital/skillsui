{
  "name": "skillsui-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Skillsui (not committed to git)",
  "main": "main.cjs",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "capital.hike.skillsui",
    "productName": "Skillsui",
    "directories": {
      "output": "release",
      "buildResources": "icons"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "identity": null,
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "resources-mac",
          "to": "."
        }
      ]
    },
    "dmg": {
      "artifactName": "Skillsui-${version}-arm64.${ext}",
      "title": "Skillsui ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "extraResources": [
        {
          "from": "resources-win",
          "to": "resources"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Skillsui-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
