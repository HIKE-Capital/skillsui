{
  "name": "skillsui",
  "version": "0.1.0",
  "private": true,
  "description": "A simple cross-platform GUI for the agent skills CLI",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "skillsui": "./dist/server/index.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.mjs",
    "portable": "node scripts/build-portable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "skills": "1.7.4"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tar": "^7.5.20",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.0.1"
  }
}
